<Window x:Class="SSDLauncher_2._0.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SSDLauncher_2._0.ViewModels"
        Title="SSDLauncher" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/icon.ico"
        ThemeMode="Dark"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="White"
        FontFamily="{DynamicResource AppFontFamily}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Border Background="{DynamicResource AppBackgroundImageBrush}" />

        <Grid Margin="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GamesItemsControl" ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="200" Height="280" Margin="12">
                                <Button Style="{StaticResource CartridgeButtonStyle}"
                Command="{Binding DataContext.PlayGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{Binding CoverImagePath}" Stretch="UniformToFill" />
                                        <TextBlock Grid.Row="1" Text="{Binding Name}"
                           Margin="8" FontSize="14" FontWeight="Bold"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                    </Grid>
                                </Button>

                                <Button Content="⚙" Style="{StaticResource IconButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                        Focusable="False"
                Command="{Binding DataContext.OpenGameSettingsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <Border x:Name="ControllerHintPanel"
        HorizontalAlignment="Right" VerticalAlignment="Bottom"
        Margin="16" Padding="12"
        Background="#CC000000" CornerRadius="8"
        Visibility="Collapsed">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="✛" FontSize="16" Width="24" TextAlignment="Center" Foreground="White" />
                    <TextBlock Text="Move" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="A" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Select" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="Y" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Settings" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>