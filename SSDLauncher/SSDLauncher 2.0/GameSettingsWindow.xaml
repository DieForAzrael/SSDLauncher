<Window x:Class="SSDLauncher_2._0.GameSettingsWindow"
        Foreground="White"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Settings" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ThemeMode="Dark">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Choose the executable to run:"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ExecutablesList" ItemsSource="{Binding Executables}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0" GroupName="ExeChoice"
             Style="{StaticResource ExecutableRadioStyle}"
             IsChecked="{Binding IsActive, Mode=OneWay}"
             Content="{Binding RelativePath}"
             Command="{Binding DataContext.SelectExecutableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
             CommandParameter="{Binding}" />

                                <Button Grid.Column="1" Content="Blacklist"
        Style="{StaticResource RowActionButtonStyle}"
        Command="{Binding DataContext.BlacklistExecutableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="B" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button Content="Close" Style="{StaticResource RowActionButtonStyle}"
                    Focusable="False"
            Click="CloseButton_Click" Width="100" />
        </StackPanel>
    </Grid>
</Window>
